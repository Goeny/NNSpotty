#!/usr/bin/env php
<?php

declare(strict_types=1);

use NnSpotty\Database\ConnectionFactory;
use NnSpotty\Database\Migrator;
use NnSpotty\Usenet\RetrieveService;
use NnSpotty\Users\UserRepository;
use NnSpotty\State\AppStateRepository;

$autoloadPath = __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoloadPath)) {
    fwrite(STDERR, "[ERROR] Composer autoload ontbreekt. Run: composer install --no-dev --optimize-autoloader\n");
    exit(1);
}
require_once $autoloadPath;

require_once __DIR__ . '/../src/helpers.php';
require_once __DIR__ . '/../src/Database/ConnectionFactory.php';
require_once __DIR__ . '/../src/Database/Migrator.php';
require_once __DIR__ . '/../src/State/AppStateRepository.php';
require_once __DIR__ . '/../src/Users/UserRepository.php';
require_once __DIR__ . '/../src/Usenet/NntpClientFactory.php';
require_once __DIR__ . '/../src/Usenet/RetrieveService.php';

loadEnvFile(__DIR__ . '/../.env');

$command = $argv[1] ?? null;

if ($command === null || in_array($command, ['help', '--help', '-h'], true)) {
    showHelp();
    exit(0);
}

try {
    if ($command === 'system') {
        handleSystemCommand($argv);
        exit(0);
    }
    if (is_file(dirname(__DIR__) . '/var/update-maintenance.json')
        && !($command === 'db' && in_array($argv[2] ?? '', ['migrate', 'health', 'status'], true))) {
        throw new RuntimeException('Onderhoudsmodus actief; rond de releaseupdate af voordat je retrieve of andere wijzigingen start.');
    }
    $pdo = ConnectionFactory::fromEnvironment();
    $migrator = new Migrator($pdo);
    $state = new AppStateRepository($pdo);

    switch ($command) {
        case 'db':
            handleDbCommand($argv, $migrator, $pdo);
            break;
        case 'user':
            handleUserCommand($argv, new UserRepository($pdo));
            if (in_array($argv[2] ?? '', ['create', 'delete', 'edit', 'password'], true)) {
                (new \NnSpotty\Audit\AuditLogRepository($pdo))->log('console', 'accounts.cli.' . $argv[2],
                    'account', $argv[3] ?? '', [], 'local');
            }
            break;
        case 'retrieve':
            handleRetrieveCommand($argv, new RetrieveService($pdo, $state));
            break;
        case 'spotters':
            $lists = new \NnSpotty\Moderation\SpotterLists($pdo);
            $action = $argv[2] ?? 'status';
            if ($action === 'sync') {
                $lists->sync(true);
                fwrite(STDOUT, "Spotlist whitelist en blacklist bijgewerkt.\n");
            } elseif ($action === 'enable' || $action === 'disable') {
                $lists->enable($action === 'enable');
                fwrite(STDOUT, 'Sleutelmoderatie ' . ($action === 'enable' ? 'ingeschakeld' : 'uitgeschakeld') . ".\n");
            } elseif ($action !== 'status') {
                throw new InvalidArgumentException('Gebruik: bin/console spotters status|sync|enable|disable');
            }
            fwrite(STDOUT, json_encode(['settings' => $lists->settings(), 'counts' => $lists->totals()],
                JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . PHP_EOL);
            break;
        default:
            throw new RuntimeException('Onbekend commando: ' . $command);
    }
} catch (Throwable $throwable) {
    fwrite(STDERR, '[ERROR] ' . $throwable->getMessage() . PHP_EOL);
    exit(1);
}

exit(0);

function handleDbCommand(array $argv, Migrator $migrator, PDO $pdo): void
{
    $action = $argv[2] ?? 'status';
    if ($action === 'migrate') {
        $migrator->migrate(static function (string $line): void {
            fwrite(STDOUT, $line . PHP_EOL);
        });
        fwrite(STDOUT, "Migrations uitgevoerd.\n");
        return;
    }

    if ($action === 'status') {
        $status = $migrator->status();
        foreach ($status as $entry) {
            $marker = $entry['executed'] ? '[x]' : '[ ]';
            fwrite(STDOUT, $marker . ' ' . $entry['name'] . PHP_EOL);
        }
        return;
    }

    if ($action === 'health') {
        $health = $migrator->health();
        fwrite(STDOUT, 'Ping: ' . $health['ping'] . PHP_EOL);
        fwrite(STDOUT, 'Server UTC: ' . $health['server_time_utc'] . PHP_EOL);
        return;
    }

    if ($action === 'cleanup') {
        $days = optionInt($argv, '--days', 90);
        $result = $migrator->cleanup($days);
        fwrite(STDOUT, 'Cleanup voltooid. comments=' . $result['post_comments_deleted'] . ' retrieval_runs=' . $result['retrieval_runs_deleted'] . ' login_attempts=' . $result['login_attempts_deleted'] . ' audit_logs=' . $result['audit_logs_deleted'] . ' tvdb_cache=' . $result['tvdb_cache_deleted'] . PHP_EOL);
        return;
    }

    if ($action === 'reindex-spots') {
        $total = (new \NnSpotty\Usenet\SpotRepository($pdo))->rebuildBrowseIndex(static function (string $line): void {
            fwrite(STDOUT, $line . PHP_EOL);
        });
        fwrite(STDOUT, 'Overzichtsindex herbouwd voor ' . $total . " spots.\n");
        return;
    }

    throw new RuntimeException('Onbekende db actie: ' . $action);
}

function handleUserCommand(array $argv, UserRepository $users): void
{
    $action = $argv[2] ?? 'list';

    if ($action === 'list') {
        $list = $users->list();
        foreach ($list as $user) {
            $role = $user['is_admin'] === 1 ? 'admin' : 'user';
            fwrite(STDOUT, $user['username'] . ' (' . $role . ', ' . ($user['active'] ? 'active' : 'inactive') . ') created=' . $user['created_at'] . PHP_EOL);
        }
        if ($list === []) {
            fwrite(STDOUT, "Geen users gevonden.\n");
        }
        return;
    }

    if ($action === 'create') {
        $username = $argv[3] ?? '';
        $password = $argv[4] ?? '';
        if ($username === '' || $password === '') {
            throw new RuntimeException('Gebruik: bin/console user create <username> <password> [--admin=1]');
        }
        $isAdmin = optionBool($argv, '--admin', false);
        $users->create($username, $password, $isAdmin, true);
        fwrite(STDOUT, "User aangemaakt: {$username}\n");
        return;
    }

    if ($action === 'delete') {
        $username = $argv[3] ?? '';
        if ($username === '') {
            throw new RuntimeException('Gebruik: bin/console user delete <username>');
        }
        $affected = $users->delete($username);
        fwrite(STDOUT, "User verwijderd: {$username} (rows={$affected})\n");
        return;
    }

    if ($action === 'password') {
        $username = $argv[3] ?? '';
        $password = $argv[4] ?? '';
        if ($username === '' || $password === '') {
            throw new RuntimeException('Gebruik: bin/console user password <username> <newPassword>');
        }
        $affected = $users->updatePassword($username, $password, true);
        fwrite(STDOUT, "Wachtwoord geüpdatet: {$username} (rows={$affected})\n");
        return;
    }

    if ($action === 'edit') {
        $username = $argv[3] ?? '';
        if ($username === '') {
            throw new RuntimeException('Gebruik: bin/console user edit <username> [--admin=1|0] [--active=1|0] [--groups=<id,id>]');
        }
        $user = $users->findByUsername($username);
        if ($user === null) throw new InvalidArgumentException('Gebruiker niet gevonden.');
        $ids = array_map('intval', array_column($users->memberships($username), 'id'));
        $active = $user['active'];
        foreach ($argv as $option) {
            if (str_starts_with($option, '--groups=')) {
                $raw = substr($option, 9);
                if (!preg_match('/^[1-9][0-9]*(?:,[1-9][0-9]*)*$/D', $raw)) throw new InvalidArgumentException('Gebruik --groups=<id,id>.');
                $ids = array_map('intval', explode(',', $raw));
            }
            if (str_starts_with($option, '--active=')) $active = optionBool($argv, '--active', $active);
            if (str_starts_with($option, '--admin=')) {
                $admin = optionBool($argv, '--admin', false);
                foreach ($users->groups() as $group) {
                    if ($group['system_key'] !== 'admins') continue;
                    $adminId = (int) $group['id'];
                    $ids = array_values(array_filter($ids, static fn (int $id): bool => $id !== $adminId));
                    if ($admin) $ids[] = $adminId;
                }
            }
        }
        if ($ids === []) {
            foreach ($users->groups() as $group) if ($group['system_key'] === 'users') $ids[] = (int) $group['id'];
        }
        $users->manage($username, $active, $ids);
        fwrite(STDOUT, "User geüpdatet: {$username}\n");
        return;
    }

    if ($action === 'groups') {
        foreach ($users->groups() as $group) fwrite(STDOUT, $group['id'] . ' ' . $group['name'] . ' (' . ($group['system_key'] ?? 'custom') . ')' . PHP_EOL);
        return;
    }

    throw new RuntimeException('Onbekende user actie: ' . $action);
}

function handleRetrieveCommand(array $argv, RetrieveService $service): void
{
    $all = optionBool($argv, '--all', false) || optionBool($argv, '--full', false);
    $sinceLast = optionBool($argv, '--since-last', false);
    $days = optionInt($argv, '--days', null);
    $verbose = optionBool($argv, '--verbose', false);
    $commentsOnly = optionBool($argv, '--comments-only', false);
    $refreshSpots = optionBool($argv, '--refresh-spots', false);

    $mode = 'since-last';
    $modeDays = null;

    if ($all) {
        $mode = 'all';
    } elseif ($days !== null) {
        $mode = 'days';
        $modeDays = $days;
    } elseif ($sinceLast) {
        $mode = 'since-last';
    }

    $result = $service->run(
        $mode,
        $modeDays,
        $verbose,
        static function (string $message): void {
            fwrite(STDOUT, '[verbose] ' . $message . PHP_EOL);
        },
        $commentsOnly,
        $refreshSpots
    );
    fwrite(STDOUT, 'Retrieve: mode=' . $result['mode'] . ' status=' . $result['status'] . ' groups=' . $result['groups'] . ' inserted=' . $result['inserted'] . PHP_EOL);
    fwrite(STDOUT, $result['message'] . PHP_EOL);
}

function handleSystemCommand(array $argv): void
{
    $action = $argv[2] ?? 'update';
    if ($action === 'verify') {
        $expected = optionValue($argv, '--version');
        if ($expected !== \NnSpotty\Config\Release::VERSION) throw new RuntimeException('Geinstalleerde releaseversie wijkt af.');
        fwrite(STDOUT, 'Release ' . \NnSpotty\Config\Release::VERSION . ' - ' . \NnSpotty\Config\Release::CODENAME . PHP_EOL);
        return;
    }
    if ($action !== 'update') {
        throw new RuntimeException('Gebruik: bin/console system update [--check]');
    }
    $root = dirname(__DIR__);
    $process = new \NnSpotty\System\Process();
    $updater = new \NnSpotty\System\Updater($root, $process, new \NnSpotty\System\Releases($process));
    if (optionBool($argv, '--check', false)) {
        $status = $updater->check();
        fwrite(STDOUT, 'Geinstalleerd: ' . $status['current'] . ' - ' . $status['codename'] . PHP_EOL);
        fwrite(STDOUT, $status['release'] === null ? "Geen gepubliceerde stabiele releases gevonden.\n"
            : 'Laatste release: ' . $status['release']['tag'] . PHP_EOL);
        fwrite(STDOUT, $status['available'] ? "Nieuwe release beschikbaar.\n" : "Geen nieuwe release beschikbaar.\n");
        if ($status['recovery']) fwrite(STDOUT, "Een eerdere update moet worden hervat; onderhoudsmodus is actief.\n");
        return;
    }
    $logPath = $root . '/var/update.log';
    $pdo = ConnectionFactory::fromEnvironment();
    $database = $pdo->query('SELECT DATABASE()')->fetchColumn();
    if (!is_string($database) || $database === '') throw new RuntimeException('Geen updatedatabase geselecteerd.');
    $lockName = 'nns:' . substr(hash('sha256', $database), 0, 60);
    $lock = $pdo->prepare('SELECT GET_LOCK(?, 0)');
    $lock->execute([$lockName]);
    if ((int) $lock->fetchColumn() !== 1) throw new RuntimeException('Er is een retrieve actief. Wacht tot deze klaar is voordat je bijwerkt.');
    try {
        $updater->update(static function (string $line) use ($logPath): void {
            fwrite(STDOUT, $line . PHP_EOL);
            if (file_put_contents($logPath, '[' . gmdate(DATE_ATOM) . '] ' . $line . PHP_EOL, FILE_APPEND | LOCK_EX) === false) {
                throw new RuntimeException('Kan updatelog niet schrijven.');
            }
        }, optionValue($argv, '--tag'));
    } finally {
        $release = $pdo->prepare('SELECT RELEASE_LOCK(?)');
        $release->execute([$lockName]);
        if ((int) $release->fetchColumn() !== 1) throw new RuntimeException('Retrieve-/updatelock kon niet worden vrijgegeven.');
    }
}

function optionValue(array $argv, string $name): ?string
{
    foreach ($argv as $argument) {
        if (str_starts_with($argument, $name . '=')) {
            return substr($argument, strlen($name) + 1);
        }
    }

    return null;
}

function optionBool(array $argv, string $name, bool $default): bool
{
    $value = optionValue($argv, $name);
    if ($value === null) {
        return in_array($name, $argv, true) ? true : $default;
    }

    return in_array(strtolower($value), ['1', 'true', 'yes', 'on'], true);
}

/**
 * @return int|null
 */
function optionInt(array $argv, string $name, ?int $default): ?int
{
    $value = optionValue($argv, $name);
    if ($value === null) {
        return $default;
    }

    if (!preg_match('/^-?\d+$/', $value)) {
        throw new RuntimeException('Optie ' . $name . ' verwacht een geheel getal.');
    }

    return (int) $value;
}

function showHelp(): void
{
    fwrite(STDOUT, "NNSpotty console\n");
    fwrite(STDOUT, "Gebruik:\n");
    fwrite(STDOUT, "  bin/console db migrate|status|health|cleanup [--days=90]|reindex-spots\n");
    fwrite(STDOUT, "  bin/console user list|groups\n");
    fwrite(STDOUT, "  bin/console user edit <username> [--admin=1|0] [--active=1|0] [--groups=<id,id>]\n");
    fwrite(STDOUT, "  bin/console user create <username> <password> [--admin=1]\n");
    fwrite(STDOUT, "  bin/console user delete <username>\n");
    fwrite(STDOUT, "  bin/console user password <username> <newPassword>\n");
    fwrite(STDOUT, "  bin/console retrieve [--all|--full|--since-last|--days=30] [--comments-only|--refresh-spots] [--verbose]\n");
    fwrite(STDOUT, "  bin/console spotters status|sync|enable|disable\n");
    fwrite(STDOUT, "  bin/console system update [--check]\n");
}
