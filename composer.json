{
  "name": "nnspotty/nnspotty",
  "version": "0.2.2",
  "description": "NNSpotty - een moderne, modulaire opvolger van Spotweb",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*",
    "ext-zlib": "*",
    "rvdv/nntp": "^1.0"
  },
  "suggest": {
    "ext-gd": "Required for processing profile avatars"
  },
  "autoload": {
    "psr-4": {
      "NnSpotty\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8080 -t public",
    "check:syntax": "php -l public/index.php",
    "console": "php bin/console",
    "test": "php tests/run.php"
  }
}
