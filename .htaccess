RewriteEngine On

# Dezelfde publieke assets bij een projectroot of public/ documentroot.
RewriteRule ^assets/(.+)$ public/assets/$1 [L]

# Laat echte bestaande files/directories door.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alle overige requests naar front controller.
RewriteRule ^ index.php [L,QSA]
